ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Optionnel : utilisé comme moteur d'IA de secours si Claude échoue pour une raison quelconque.
# Laissez la variable vide pour passer directement au moteur local hors ligne en cas d'échec de Claude.
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o
# Optionnel : 3e moteur de secours (texte uniquement, pas de vision) utilisant une instance
# Ollama locale — utile pour garder l'analyse de texte et le chat fonctionnels même si Claude
# et OpenAI sont tous les deux indisponibles (crédit épuisé, clé manquante, panne...).
# Installer Ollama (https://ollama.com), lancer `ollama pull llama3.2`, puis laisser ces
# valeurs par défaut si Ollama tourne sur cette machine. Aucune clé requise.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"documind-d081e","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@documind-d081e.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081
PORT=3001

# Stripe — abonnement « Bill Benefit » (10 $/mois).
# Clé secrète Stripe (sk_test_… pour les essais, sk_live_… en production). Ne jamais la committer.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…) — Dashboard Stripe > Developers > Webhooks,
# endpoint : https://<votre-backend>/api/stripe/webhook
# Événements : checkout.session.completed, invoice.paid, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Optionnel : ID du prix récurrent (price_…). Sans lui, un prix de 10 $/mois est créé à la volée.
STRIPE_MEMBERSHIP_PRICE_ID=
# Optionnel : URL de l'application pour les redirections Stripe si l'origine de la requête est inconnue.
APP_URL=
